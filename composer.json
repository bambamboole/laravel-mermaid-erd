{
    "name": "bambamboole/laravel-mermaid-erd",
    "description": "This is my package laravel-mermaid-erd",
    "keywords": [
        "bambamboole",
        "laravel",
        "laravel-mermaid-erd"
    ],
    "homepage": "https://github.com/bambamboole/laravel-mermaid-erd",
    "license": "MIT",
    "authors": [
        {
            "name": "bambamboole",
            "email": "manuel@christlieb.eu",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^11.0||^12.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "laravel/pint": "^1.14",
        "larastan/larastan": "^2.9||^3.0",
        "nunomaduro/collision": "^8.1.1",
        "orchestra/testbench": "^9.0||^10.0",
        "pestphp/pest": "^2.34||^3.0",
        "pestphp/pest-plugin-arch": "^2.7||^3.0",
        "pestphp/pest-plugin-laravel": "^2.3||^3.0",
        "phpstan/extension-installer": "^1.3",
        "phpstan/phpstan-deprecation-rules": "^1.1||^2.0",
        "phpstan/phpstan-phpunit": "^1.3||^2.0"
    },
    "autoload": {
        "psr-4": {
            "Bambamboole\\LaravelMermaidErd\\": "src/",
            "Bambamboole\\LaravelMermaidErd\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Bambamboole\\LaravelMermaidErd\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "clear": "@php vendor/bin/testbench package:purge-laravel-mermaid-erd --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": [
            "@composer run prepare",
            "@php vendor/bin/testbench workbench:build --ansi"
        ],
        "start": [
            "Composer\\Config::disableProcessTimeout",
            "@composer run build",
            "@php vendor/bin/testbench serve"
        ],
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Bambamboole\\LaravelMermaidErd\\LaravelMermaidErdServiceProvider"
            ],
            "aliases": {
                "LaravelMermaidErd": "Bambamboole\\LaravelMermaidErd\\Facades\\LaravelMermaidErd"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
