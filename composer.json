{
    "name": "bambamboole/laravel-mermaid-erd",
    "description": "Generate Mermaid.js ER diagrams from your Laravel database schema",
    "keywords": [
        "bambamboole",
        "laravel",
        "laravel-mermaid-erd",
        "mermaid",
        "erd",
        "database",
        "schema",
        "diagram"
    ],
    "homepage": "https://github.com/bambamboole/laravel-mermaid-erd",
    "license": "MIT",
    "authors": [
        {
            "name": "bambamboole",
            "email": "manuel@christlieb.eu",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/contracts": "^13.0",
        "laravel/prompts": "^0.3",
        "spatie/php-structure-discoverer": "^2.4"
    },
    "require-dev": {
        "bambamboole/extended-testbench": "^0.6.1",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.16",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "pestphp/pest-plugin-phpstan": "^5.0",
        "phpstan/phpstan-mockery": "^2.0",
        "rector/rector": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Bambamboole\\LaravelMermaidErd\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Bambamboole\\LaravelMermaidErd\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "scripts": {
        "test": "pest",
        "stan": "phpstan analyse",
        "refactor": "rector",
        "lint": "pint --format agent",
        "check": [
            "pint --test",
            "phpstan analyse",
            "rector --dry-run",
            "@test"
        ],
        "post-autoload-dump": [
            "@php vendor/bin/testbench package:purge-skeleton --ansi",
            "@php vendor/bin/testbench package:discover --ansi"
        ],
        "boost:refresh": "[ -n \"$CI\" ] || [ ! -f vendor/bin/testbench ] || [ ! -f boost.json ] || { [ -f package.json ] && [ ! -d node_modules ]; } || vendor/bin/testbench boost:update --no-interaction || true",
        "post-install-cmd": [
            "@boost:refresh"
        ],
        "post-update-cmd": [
            "@boost:refresh"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Bambamboole\\LaravelMermaidErd\\LaravelMermaidErdServiceProvider"
            ]
        },
        "extended-testbench": {
            "check-ignore": [
                "phpstan.neon.dist"
            ]
        }
    },
    "minimum-stability": "stable"
}
